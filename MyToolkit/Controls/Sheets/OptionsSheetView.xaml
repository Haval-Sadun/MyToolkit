<?xml version="1.0" encoding="UTF-8" ?>
<controls:SheetContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyToolkit.Controls.Sheets"
             x:Class="MyToolkit.Controls.Sheets.OptionsSheetView"
             x:DataType="controls:OptionsSheetViewModel">

    <!-- OnPrimaryColor is put in Resources by SheetContentView (palette-derived). -->
    <VerticalStackLayout Spacing="12" Padding="0,0,0,8">

        <!-- The item: cover over its placeholder, title, subtitle. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="{DynamicResource BackgroundSecondaryColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid>
                    <Label Text="{Binding PlaceholderGlyph}" FontFamily="MaterialIcons" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource TextSecondaryColor}" />
                    <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Title}" FontSize="16" MaxLines="2" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppSemiBoldFamily}" TextColor="{DynamicResource TextColor}" />
                <Label Text="{Binding Subtitle}" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />
            </VerticalStackLayout>
        </Grid>

        <!-- The one main action. -->
        <Button x:Name="PlayButton" Text="{Binding Play.Text}" Command="{Binding Play.Command}" IsVisible="{Binding HasPlay}"
                HeightRequest="48" CornerRadius="24" FontSize="16" Padding="16,0" FontFamily="{DynamicResource AppSemiBoldFamily}" BackgroundColor="{DynamicResource PrimaryColor}" />

        <!-- Quick actions: icon over a short label, in evenly filled rows (the columns are set by the code-behind from the number of tiles). -->
        <Grid x:Name="QuickGrid" ColumnSpacing="8" RowSpacing="8" IsVisible="{Binding HasQuick}" BindableLayout.ItemsSource="{Binding Quick}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="controls:OptionsEntry">
                    <Border Grid.Row="{Binding GridRow}" Grid.Column="{Binding GridColumn}" MinimumHeightRequest="76" StrokeThickness="0" Padding="4,10" BackgroundColor="{DynamicResource BackgroundSecondaryColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Command}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="{Binding Icon}" FontFamily="MaterialIcons" FontSize="24" HorizontalOptions="Center" TextColor="{DynamicResource TextColor}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource PopupDangerColor}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Text}" FontSize="12" MaxLines="2" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextColor}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </Grid>

        <!-- The rest, grouped by what they do. -->
        <VerticalStackLayout Spacing="10" IsVisible="{Binding HasGroups}" BindableLayout.ItemsSource="{Binding Groups}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="controls:OptionsGroup">
                    <Border StrokeThickness="1" Stroke="{DynamicResource PopupBorderColor}" BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="controls:OptionsEntry">
                                    <VerticalStackLayout>
                                        <BoxView HeightRequest="1" IsVisible="{Binding ShowDivider}" Color="{DynamicResource PopupBorderColor}" />
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="12" HeightRequest="50" Padding="14,0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Command}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding Icon}" FontFamily="MaterialIcons" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" TextColor="{DynamicResource TextSecondaryColor}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDestructive}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource PopupDangerColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding Text}" FontSize="15" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextColor}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDestructive}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource PopupDangerColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</controls:SheetContentView>
