<?xml version="1.0" encoding="UTF-8" ?>
<controls:SheetContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyToolkit.Controls.Sheets"
             x:Class="MyToolkit.Controls.Sheets.ChoiceSheetView"
             x:DataType="controls:ChoiceSheetViewModel">

    <VerticalStackLayout Spacing="8" Padding="0,0,0,8">
        <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="13" Margin="0,0,0,2" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />

        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Rows}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="controls:ChoiceRow">
                    <Border MinimumHeightRequest="56" StrokeThickness="1" Padding="12,6" BackgroundColor="Transparent" Stroke="{DynamicResource PopupBorderColor}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundSecondaryColor}" />
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Command}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <controls:SheetBadge Badge="{Binding Badge}" IsIcon="{Binding BadgeIsIcon}" Size="36" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Title}" FontSize="16" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextColor}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="FontFamily" Value="{DynamicResource AppSemiBoldFamily}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <controls:SheetCheck Grid.Column="2" IsChecked="{Binding IsSelected}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Border IsVisible="{Binding HasNote}" StrokeThickness="0" Padding="12,8" BackgroundColor="{DynamicResource BackgroundSecondaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{x:Static controls:SheetGlyphs.Refresh}" FontFamily="MaterialIcons" FontSize="16" VerticalOptions="Center" TextColor="{DynamicResource TextSecondaryColor}" />
                <Label Grid.Column="1" Text="{Binding Note}" FontSize="12" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</controls:SheetContentView>
