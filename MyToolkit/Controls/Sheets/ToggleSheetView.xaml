<?xml version="1.0" encoding="UTF-8" ?>
<controls:SheetContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MyToolkit.Controls.Sheets"
             xmlns:tk="clr-namespace:MyToolkit.Controls"
             x:Class="MyToolkit.Controls.Sheets.ToggleSheetView"
             x:DataType="controls:ToggleSheetViewModel">

    <!-- OnPrimaryColor is put in Resources by SheetContentView (palette-derived). -->
    <controls:SheetContentView.Resources>
        <Button x:Key="Footer" x:DataType="controls:ToggleSheetViewModel" Text="{Binding DoneText}" Command="{Binding DoneCommand}"
                HeightRequest="48" CornerRadius="24" FontSize="16" Padding="16,0" FontFamily="{DynamicResource AppSemiBoldFamily}" BackgroundColor="{DynamicResource PrimaryColor}" />
    </controls:SheetContentView.Resources>

    <VerticalStackLayout Spacing="4">
        <!-- What is being filed, with "New" where people look for create. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,0,0,4" IsVisible="{Binding HasHeader}">
            <Label Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />
            <tk:PillButton Grid.Column="1" Text="{Binding NewText}" Icon="{x:Static controls:SheetGlyphs.Add}" Command="{Binding NewCommand}" IsVisible="{Binding HasNew}" />
        </Grid>

        <ScrollView MaximumHeightRequest="320">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="controls:ToggleRow">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="56">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center" IsVisible="{Binding HasBadge}" BackgroundColor="{DynamicResource BackgroundSecondaryColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Label Text="{Binding Badge}" IsVisible="{Binding BadgeIsIcon}" FontFamily="MaterialIcons" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource TextSecondaryColor}" />
                                    <Label Text="{Binding Badge}" IsVisible="{Binding BadgeIsText}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{DynamicResource AppSemiBoldFamily}" TextColor="{DynamicResource TextColor}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Title}" FontSize="16" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextColor}" />
                                <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="{DynamicResource AppFontFamily}" TextColor="{DynamicResource TextSecondaryColor}" />
                            </VerticalStackLayout>
                            <!-- Empty ring while the item is out, filled with a check once it is in. -->
                            <Border Grid.Column="2" WidthRequest="24" HeightRequest="24" StrokeThickness="1.5" VerticalOptions="Center" BackgroundColor="Transparent" Stroke="{DynamicResource PopupBorderColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{x:Static controls:SheetGlyphs.Check}" FontFamily="MaterialIcons" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{DynamicResource OnPrimaryColor}" IsVisible="{Binding IsSelected}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</controls:SheetContentView>
