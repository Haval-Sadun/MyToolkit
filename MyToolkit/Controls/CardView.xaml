<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyToolkit.Controls.CardView"
             x:Name="this">
    <Border x:Name="CardBorder"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            Padding="{Binding CardPadding, Source={x:Reference this}}"
            BackgroundColor="{Binding CardBackground, Source={x:Reference this}}">
        <Border.Shadow>
            <Shadow Brush="{Binding ShadowBrush, Source={x:Reference this}}"
                    Offset="{Binding ShadowOffset, Source={x:Reference this}}"
                    Radius="{Binding ShadowRadius, Source={x:Reference this}}"
                    Opacity="{Binding ShadowOpacity, Source={x:Reference this}}" />
        </Border.Shadow>
        <VerticalStackLayout Spacing="{Binding SectionSpacing, Source={x:Reference this}}">
            <!-- Optional header slot; hidden when null -->
            <ContentView x:Name="HeaderSlot"
                         Content="{Binding Header, Source={x:Reference this}}"
                         IsVisible="{Binding HasHeader, Source={x:Reference this}}" />
            <!-- Main content slot -->
            <ContentView Content="{Binding Body, Source={x:Reference this}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
